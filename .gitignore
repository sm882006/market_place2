# =======================================================
# Git Ignore Configuration for Fullstack React + Node.js
# =======================================================

# 1. Dependencies (Installed automatically via `npm install`)
node_modules/
.pnp
.pnp.js

# 2. Production & Build Outputs (Generated when building)
dist/
dist-ssr/
build/
*.local

# 3. Environment Variables & Secrets (NEVER push API keys or passwords!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Archive & Compressed Files (Prevents uploading heavy ZIPs to GitHub)
*.zip
*.tar.gz
*.rar
*.7z

# 6. Operating System Files (macOS & Windows temporary junk)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 7. IDE & Code Editor Configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Caches & Test Coverage
.eslintcache
.cache/
coverage/
