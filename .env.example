# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster_host>/campus_marketplace?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# College Domain Filter
COLLEGE_DOMAIN=pict.edu

# Optional Email / SMTP Configuration for Production OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
